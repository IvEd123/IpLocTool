<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="16dp" android:background="@drawable/card">
    <LinearLayout android:id="@+id/widget_info" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical" android:gravity="center_vertical">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/public_ip" android:textColor="#A5BACB" android:textSize="11sp" android:includeFontPadding="false"/>
        <TextView android:id="@+id/widget_ip" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="@string/empty_ip" android:textColor="#83E8C3" android:textSize="22sp" android:fontFamily="monospace" android:includeFontPadding="false" android:maxLines="2" android:ellipsize="end"/>
        <TextView android:id="@+id/widget_place" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="@string/empty_place" android:textColor="#FFFFFF" android:textSize="14sp" android:includeFontPadding="false" android:maxLines="2" android:ellipsize="end"/>
        <TextView android:id="@+id/widget_provider" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#A5BACB" android:textSize="12sp" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end"/>
        <TextView android:id="@+id/widget_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="@string/manual_only" android:textColor="#A5BACB" android:textSize="11sp" android:includeFontPadding="false" android:maxLines="2" android:ellipsize="end"/>
    </LinearLayout>
    <Button android:id="@+id/widget_check" android:layout_width="match_parent" android:layout_height="48dp" android:text="@string/check" android:textAllCaps="false" android:textColor="#101A24" android:backgroundTint="#83E8C3"/>
</LinearLayout>
