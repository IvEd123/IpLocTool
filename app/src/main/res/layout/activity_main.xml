<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/main_root" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#101A24">
    <ScrollView android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:text="@string/app_name" android:textSize="30sp" android:textStyle="bold" android:textColor="#F1F6FA"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/subtitle" android:textSize="16sp" android:textColor="#A5BACB"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="32dp" android:padding="24dp" android:orientation="vertical" android:background="@drawable/card">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/public_ip" android:textSize="12sp" android:letterSpacing="0.12" android:textColor="#83E8C3"/>
                <TextView android:id="@+id/ip" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:textSize="28sp" android:fontFamily="monospace" android:textColor="#FFFFFF" android:textIsSelectable="true"/>
                <TextView android:id="@+id/place" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:textSize="19sp" android:textColor="#F1F6FA"/>
                <TextView android:id="@+id/provider" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textSize="14sp" android:textColor="#A5BACB"/>
                <TextView android:id="@+id/status" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:textSize="13sp" android:textColor="#A5BACB" android:accessibilityLiveRegion="polite"/>
            </LinearLayout>
            <Button android:id="@+id/check" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:layout_marginTop="24dp" android:text="@string/check" android:textAllCaps="false" android:textColor="#101A24" android:backgroundTint="#83E8C3"/>
            <Button android:id="@+id/add_widget" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:layout_marginTop="8dp" android:text="@string/add_widget" android:textAllCaps="false"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:text="@string/privacy_note" android:textSize="13sp" android:textColor="#A5BACB"/>
        </LinearLayout>
    </ScrollView>
</FrameLayout>
